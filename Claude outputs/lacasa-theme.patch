diff --git a/src/index.css b/src/index.css
index 1411999..7a1d1aa 100644
--- a/src/index.css
+++ b/src/index.css
@@ -2,33 +2,61 @@
 
 /* ---------------------------------------------------------------------------
    LA CASA design tokens.
-   Brand magenta carried over from the Glide prototype, darkened to #C2185B so
-   body text and buttons clear WCAG AA on white (5.9:1 rather than 3.4:1).
-   Type scale runs large by default: the audience includes parents reading on
-   small phones, often in a second language.
+
+   Light blue theme. The Glide prototype's magenta was a baseline, not a brand
+   requirement; blue reads calmer and more clinical, which suits health guidance
+   coming from a hospital. The old magenta survives as the `berry` accent so the
+   CASA identity is not lost entirely.
+
+   Contrast is the constraint, not taste: brand-600 sits at 5.4:1 on white, so
+   it works both as button fill under white text and as text on a white card.
+   The pale end of each ramp is a tint only — never put text on it below -800.
+
+   Type runs large by default: the audience includes parents reading on small
+   phones, often in a second language.
 --------------------------------------------------------------------------- */
 @theme {
-  --color-brand-50:  #FDF2F7;
-  --color-brand-100: #FCE7F1;
-  --color-brand-200: #FBCFE3;
-  --color-brand-300: #F9A8CC;
-  --color-brand-400: #F472AE;
-  --color-brand-500: #E0218A;
-  --color-brand-600: #C2185B;
-  --color-brand-700: #9D174D;
-  --color-brand-800: #831843;
-  --color-brand-900: #6B1338;
-
-  --color-leaf-500: #2E9E5B;
-  --color-leaf-600: #1F7A44;
-  --color-sun-500:  #F0A202;
-  --color-sky-500:  #0284C7;
-
-  --color-ink:      #1A1220;
-  --color-ink-soft: #574C60;
-  --color-line:     #EAE3EE;
+  /* Brand — light blue */
+  --color-brand-50:  #F0F7FD;
+  --color-brand-100: #DDEDFA;
+  --color-brand-200: #BEDDF5;
+  --color-brand-300: #93C7EE;
+  --color-brand-400: #5EABE2;
+  --color-brand-500: #2E8FD4;
+  --color-brand-600: #1B6FAE;
+  --color-brand-700: #15578A;
+  --color-brand-800: #114568;
+  --color-brand-900: #0D3450;
+
+  /* Module accents. Each carries a -100 tint, a -500 mark and an -800 text
+     value so a module's color is one decision, not three. */
+  --color-leaf-100:  #DCF3E5;
+  --color-leaf-500:  #2E9E5B;
+  --color-leaf-600:  #1F7A44;
+  --color-leaf-800:  #10603A;
+
+  --color-sun-100:   #FDEECB;
+  --color-sun-500:   #F0A202;
+  --color-sun-600:   #C77F00;
+  --color-sun-800:   #8A5A00;
+
+  --color-berry-100: #FBDCEA;
+  --color-berry-500: #D6337F;
+  --color-berry-600: #B02566;
+  --color-berry-800: #7E1A49;
+
+  /* Teal rather than blue, so Hydration stays distinct from the brand. */
+  --color-aqua-100:  #D3F0F6;
+  --color-aqua-500:  #0E9BB5;
+  --color-aqua-600:  #0B7D93;
+  --color-aqua-800:  #075A6B;
+
+  /* Neutrals, cooled to sit under a blue brand rather than fight it. */
+  --color-ink:      #10202E;
+  --color-ink-soft: #4A6172;
+  --color-line:     #DCE8F2;
   --color-surface:  #FFFFFF;
-  --color-canvas:   #FBF8FC;
+  --color-canvas:   #F4F9FD;
 
   --font-sans: "Nunito", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
   --radius-card: 1.25rem;
